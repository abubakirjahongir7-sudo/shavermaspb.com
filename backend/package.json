{
  "name": "shaverma-spb-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "prisma migrate deploy && node src/index.js",
    "postinstall": "prisma generate",
