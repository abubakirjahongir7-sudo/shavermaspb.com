# PostgreSQL ulanish satri (Prisma shu formatda kutadi)
DATABASE_URL="postgresql://user:password@localhost:5432/shaverma_spb?schema=public"

# PWA (frontend) manzili — CORS faqat shu manzildan kelgan so'rovlarga ruxsat beradi
FRONTEND_URL=https://example.com

# HTTP server porti (PWA buyurtmalari + admin panel API'si shu yerda)
PORT=3001

# Admin panel uchun parol (frontend /admin sahifasida so'raladi)
ADMIN_PASSWORD=

# Web Push (admin va mijozlar telefoniga bildirishnoma). Kalitlarni yaratish:
#   npx web-push generate-vapid-keys
# Bo'sh qoldirilsa — push o'chiq, qolgan hammasi ishlayveradi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ЮKassa (karta va SBP). Bo'sh qoldirilsa — faqat naqd to'lov ishlaydi.
# Bildirishnoma manzili: https://<backend-domen>/api/payments/yookassa
# (payment.succeeded va payment.canceled hodisalari). FRONTEND_URL ham majburiy.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 54-ФЗ cheki ЮKassa orqali yuborilsa — true. YOOKASSA_VAT_CODE: 1 = без НДС.
YOOKASSA_SEND_RECEIPT=false
YOOKASSA_VAT_CODE=1

# Yandex Доставка (kuryer). Kafening o'z kuryeri yo'q, shuning uchun yetkazib berish
# faqat shu sozlamalar va ЮKassa kalitlari to'liq bo'lganda yoqiladi.
# Token: Yandex Доставка kabineti -> Интеграции -> Получить токен.
YANDEX_DELIVERY_TOKEN=
# Kuryer bog'lanadigan kafe telefoni va pochtasi
CAFE_PHONE=
CAFE_EMAIL=
# courier yoki express
YANDEX_DELIVERY_TAXI_CLASS=express
